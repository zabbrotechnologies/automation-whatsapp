{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/login(.html)?",
      "destination": "/public/login.html"
    },
    {
      "source": "/admin(.html)?",
      "destination": "/public/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
